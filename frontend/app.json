{
  "expo": {
    "name": "Ihyaa",
    "slug": "ihyaa",
    "scheme": "ihyaa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B3B36"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.ihyaa.mobile"
    },
    "android": {
      "package": "app.ihyaa.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B3B36"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-localization",
      "expo-notifications"
    ]
  }
}
